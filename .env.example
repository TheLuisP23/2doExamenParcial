# Copia este archivo a .env (gitignored) para desarrollo local: `cp .env.example .env`
# Valores SOLO para desarrollo local. En EKS los secretos se crean con scripts/ (ver specs/004-plataforma).

# --- PostgreSQL (servicio A) ---
POSTGRES_DB=books
POSTGRES_USER=books
POSTGRES_PASSWORD=change-me-local-only

# --- Servicio A ---
SERVICE_A_PORT=8000
SERVICE_A_DATABASE_URL=postgresql+psycopg://books:change-me-local-only@postgres:5432/books
SERVICE_A_LOG_LEVEL=INFO

# --- MongoDB (servicio B) ---
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-local-only

# --- Servicio B ---
SERVICE_B_PORT=3000
SERVICE_B_MONGO_URI=mongodb://root:change-me-local-only@mongo:27017/members?authSource=admin
SERVICE_B_LOG_LEVEL=info
SERVICE_B_MAX_ACTIVE_LOANS=3
SERVICE_B_DEFAULT_LOAN_DAYS=14

# --- Frontend (Nginx) ---
FRONTEND_PORT=8080
SERVICE_A_UPSTREAM=http://service-a:8000
SERVICE_B_UPSTREAM=http://service-b:3000
