{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(make verify)",
      "Bash(make verify:*)",
      "Bash(make verify-release)",
      "Bash(make status)",
      "Bash(make check)",
      "Bash(make init)",
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make e2e)",
      "Bash(make test:*)",
      "Bash(make lint)",
      "Bash(make contracts)",
      "Bash(make traceability)",
      "Bash(make feature-check)",
      "Bash(make task-start:*)",
      "Bash(make task-done:*)",
      "Bash(make task-abort)",
      "Bash(make task-list)",
      "Bash(make feature-pass:*)",
      "Bash(make end-session)",
      "Bash(make tf-plan)",
      "Bash(make cluster-dry-run)",
      "Bash(make smoke:*)",
      "Bash(./init.sh:*)",
      "Bash(bash init.sh:*)",
      "Bash(bash scripts/py.sh:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx --no-install:*)",
      "Bash(npx playwright:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(pip install:*)",
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(docker info)",
      "Bash(docker compose:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl version:*)",
      "Bash(kubectl rollout status:*)",
      "Bash(kubeconform:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform init:*)",
      "Bash(terraform test:*)",
      "Bash(terraform version)",
      "Bash(eksctl get:*)",
      "Bash(eksctl version)",
      "Bash(eksctl utils describe-addon-versions:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws eks describe-cluster:*)",
      "Bash(aws eks list-clusters:*)",
      "Bash(aws ecr describe-repositories:*)",
      "Bash(aws ecr describe-images:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(gitleaks:*)",
      "Bash(pre-commit run:*)"
    ],
    "ask": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(eksctl create:*)",
      "Bash(eksctl delete:*)",
      "Bash(eksctl upgrade:*)",
      "Bash(eksctl scale:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl replace:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl set:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(kubectl rollout undo:*)",
      "Bash(kubectl exec:*)",
      "Bash(make infra-up)",
      "Bash(make infra-down)",
      "Bash(make deploy)",
      "Bash(make k8s-bootstrap)",
      "Bash(make k8s-secrets)",
      "Bash(docker push:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)"
    ],
    "deny": [
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Edit(~/.aws/**)",
      "Write(~/.aws/**)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Write(./.env)",
      "Write(./**/.env)",
      "Read(~/.kube/config)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat .env)",
      "Bash(aws configure:*)",
      "Bash(aws iam create-access-key:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf /:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/init.sh\" --check",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/py.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/scope_guard.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/py.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit.py\"",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/py.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.py\"",
            "timeout": 1200
          }
        ]
      }
    ]
  }
}
